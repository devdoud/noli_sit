---
// Pied de page (spec 0002, AC-5 ; retravaillé le 2026-10-17) : colonne marque avec les boutons
// des stores, liens légaux des pages déjà construites, aide (support, questions fréquentes),
// barre du bas avec le copyright de l'année du build et l'éditeur.
import StoreButtons from './StoreButtons.astro'
import { footerLinks, publisher, routes, site } from '../config/site'

const year = new Date().getFullYear()
const publisherLine = [publisher.name, publisher.address, publisher.country]
  .filter((part) => part.trim() !== '')
  .join(', ')

const heading = 'font-mono text-[11px] font-semibold tracking-[0.2em] text-text-meta uppercase'
const link =
  'inline-flex min-h-11 items-center gap-2 text-text underline decoration-white/20 underline-offset-4 transition-colors hover:text-brand-bright hover:decoration-brand-bright'
---

<footer class="relative overflow-hidden border-t border-border bg-surface/70 text-sm leading-6">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-brand/70 to-transparent shadow-[0_0_20px_1px_var(--color-brand)]"
  ></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-40 left-1/2 size-[36rem] -translate-x-1/2 bg-radial from-violet/15 to-transparent to-70%"
  ></div>

  <div class="relative mx-auto grid w-full max-w-5xl gap-12 px-5 pt-16 pb-12 md:grid-cols-[1.5fr_1fr_1fr] md:gap-8">
    <div class="flex flex-col gap-5">
      <a
        href={routes.home}
        class="inline-flex min-h-11 w-fit items-center font-display text-3xl font-extrabold tracking-[-0.03em] text-text transition-colors hover:text-brand-bright"
      >
        {site.name}
      </a>
      <p class="max-w-xs text-text-meta">
        Le streaming de séries pensé pour l’Afrique de l’Ouest francophone.
      </p>
      <div class="flex flex-col gap-3">
        <p class={heading}>L’app arrive sur les stores</p>
        <StoreButtons />
      </div>
    </div>

    <div class="flex flex-col gap-3">
      <p class={heading}>Informations légales</p>
      {footerLinks.length > 0 && (
        <nav aria-label="Liens légaux">
          <ul class="flex flex-col">
            {footerLinks.map((entry) => (
              <li>
                <a href={entry.href} class={link}>
                  {entry.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </div>

    <div class="flex flex-col gap-3">
      <p class={heading}>Aide</p>
      <ul class="flex flex-col">
        <li>
          <a href={`${routes.home}#questions`} class={link}>
            Questions fréquentes
          </a>
        </li>
        <li>
          <a href={`mailto:${site.supportEmail}`} class={link}>
            {site.supportEmail}
          </a>
        </li>
      </ul>
      <p class="text-text-meta">Nous répondons par email.</p>
    </div>
  </div>

  <div class="relative border-t border-border">
    <div class="mx-auto flex w-full max-w-5xl flex-col gap-1 px-5 py-6 text-xs text-text-meta md:flex-row md:items-center md:justify-between">
      <p>
        © {year} {site.name}
      </p>
      {publisherLine !== '' && <p>Édité par {publisherLine}</p>}
    </div>
  </div>

  <p
    aria-hidden="true"
    class="pointer-events-none relative -mb-[0.22em] text-center font-display text-[26vw] leading-[0.8] font-extrabold tracking-[-0.05em] text-transparent select-none [-webkit-text-stroke:1px_color-mix(in_oklab,var(--color-text)_10%,transparent)] md:text-[17rem]"
  >
    {site.name}
  </p>
</footer>
