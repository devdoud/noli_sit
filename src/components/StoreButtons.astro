---
import { storeLinks } from '../config/site'

// Boutons des stores (spec 0002, AC-6) avec les logos Google Play et Apple dans leurs vraies
// couleurs (demande du porteur, 2026-10-17). Lien null : simple élément « Bientôt disponible »,
// sans lien ni état ARIA. Lien renseigné : un vrai lien. À la publication, passer aux badges
// officiels des stores. Les couleurs ci dessous sont celles des marques, seule exception aux jetons.

// Tracés : Simple Icons (CC0), découpés par couleur. Marques de Google LLC et d'Apple Inc.
const logos = {
  googlePlay: [
    // Partie gauche, bleue
    {
      d: 'M1.337.924a1.486 1.486 0 0 0-.112.568v21.017c0 .217.045.419.124.6l11.155-11.087L1.337.924z',
      fill: '#4285F4',
    },
    // Partie haute, verte
    {
      d: 'M13.544 10.989l3.258-3.238L3.45.195a1.466 1.466 0 0 0-.946-.179l11.04 10.973z',
      fill: '#34A853',
    },
    // Partie basse, rouge
    {
      d: 'M13.544 13.056l-11 10.933c.298.036.612-.016.906-.183l13.324-7.54-3.23-3.21z',
      fill: '#EA4335',
    },
    // Pointe droite, jaune
    {
      d: 'M22.018 13.298l-3.919 2.218-3.515-3.493 3.543-3.521 3.891 2.202a1.49 1.49 0 0 1 0 2.594z',
      fill: '#FBBC04',
    },
  ],
  // Le logo Apple est monochrome : blanc sur fond sombre.
  apple: [
    {
      d: 'M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701',
      fill: '#FFFFFF',
    },
  ],
} as const

const stores = [
  {
    name: 'Google Play',
    download: 'Télécharger sur Google Play',
    href: storeLinks.googlePlay,
    logo: logos.googlePlay,
  },
  {
    name: 'App Store',
    download: "Télécharger sur l'App Store",
    href: storeLinks.appStore,
    logo: logos.apple,
  },
] as const

const shape = 'inline-flex min-h-12 items-center gap-3 rounded-2xl px-4 py-2'
---

<ul class="flex flex-wrap gap-3">
  {stores.map((store) => (
    <li data-magnetic>
      {store.href ? (
        <a
          href={store.href}
          class={`${shape} border border-border-mid bg-canvas text-text transition-colors hover:border-brand/60`}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" class="size-6 shrink-0">
            {store.logo.map((part) => (
              <path d={part.d} fill={part.fill} />
            ))}
          </svg>
          <span class="text-sm leading-5 font-semibold">{store.download}</span>
        </a>
      ) : (
        <span
          class={`${shape} border border-border-mid bg-surface-high/80 shadow-[0_0_0_1px_rgb(255_255_255/0.02),0_10px_30px_-12px_rgb(0_0_0/0.8)] backdrop-blur`}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" class="size-6 shrink-0">
            {store.logo.map((part) => (
              <path d={part.d} fill={part.fill} />
            ))}
          </svg>
          <span class="flex flex-col">
            <span class="text-sm leading-5 font-semibold text-text">{store.name}</span>
            <span class="text-xs leading-4 text-text-meta">Bientôt disponible</span>
          </span>
        </span>
      )}
    </li>
  ))}
</ul>
