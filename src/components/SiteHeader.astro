---
// Haut de page (spec 0002, AC-4) : le mot « Noli » seul, en lien vers l'accueil.
import { routes, site } from '../config/site'
---

<header class="border-b border-border bg-surface">
  <div class="mx-auto flex min-h-14 w-full max-w-5xl items-center px-5">
    <a
      href={routes.home}
      class="inline-flex min-h-11 items-center font-display text-2xl font-extrabold tracking-[-0.03em] text-text transition-colors hover:text-brand-bright"
    >
      {site.name}
    </a>
  </div>
</header>
