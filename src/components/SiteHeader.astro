---
// Haut de page (spec 0002) : l'icône de l'app et le mot « Noli », un seul lien vers l'accueil.
import { Image } from 'astro:assets'
import logo from '../assets/noli-logo.png'
import { routes, site } from '../config/site'
---

<header class="border-b border-border bg-surface">
  <div class="mx-auto flex min-h-14 w-full max-w-3xl items-center px-5">
    <a
      href={routes.home}
      class="inline-flex min-h-11 items-center gap-3 font-display text-xl font-bold tracking-[-0.02em] text-text"
    >
      <Image src={logo} alt="" width={64} height={64} class="size-8" loading="eager" />
      {site.name}
    </a>
  </div>
</header>
