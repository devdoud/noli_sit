---
// Accueil provisoire du socle. La vraie vitrine arrive avec la feature 8.
import BaseLayout from '../layouts/BaseLayout.astro'
import { site } from '../config/site'
---

<BaseLayout
  title={site.name}
  description="Noli, le streaming de séries pour l'Afrique de l'Ouest francophone. Bientôt disponible."
>
  <main class="mx-auto max-w-2xl px-4 py-16">
    <h1 class="text-brand text-4xl font-bold">{site.name}</h1>
    <p class="mt-4">Bientôt disponible.</p>
  </main>
</BaseLayout>
