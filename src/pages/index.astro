---
// Accueil provisoire du socle. La vraie vitrine arrive avec la feature 8.
import BaseLayout from '../layouts/BaseLayout.astro'
import { site } from '../config/site'
---

<BaseLayout description="Noli, le streaming de séries pour l'Afrique de l'Ouest francophone. Bientôt disponible.">
  <div class="mx-auto w-full max-w-3xl px-5 py-10 md:py-16">
    <h1 class="text-brand">{site.name}</h1>
    <p class="mt-4 text-text-meta">
      Le streaming de séries pour l'Afrique de l'Ouest francophone. Bientôt disponible.
    </p>
  </div>
</BaseLayout>
